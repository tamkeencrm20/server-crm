# ---------- Runtime ----------
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/tamkeen_crm

# ---------- Auth ----------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- Frontend ----------
CORS_ORIGINS=http://localhost:5173

# ---------- Meta Lead Ads (optional until the Business account is connected) ----------
# App Dashboard > Settings > Basic > App Secret
META_APP_SECRET=
# Any random string you also type into the Webhook "Verify Token" field
META_VERIFY_TOKEN=
# Page access token with leads_retrieval + pages_manage_ads
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# ---------- Lead handling ----------
LEAD_DEDUPE_WINDOW_DAYS=30
LEAD_STALE_HOURS=4
ENABLE_CRON=true
